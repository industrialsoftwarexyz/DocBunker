{
  "manifest_version": 3,
  "name": "DocBunker for Gmail",
  "version": "0.1.0",
  "description": "Open a Gmail attachment in the isolated DocBunker viewer.",
  "icons": {
    "128": "icon-128.png"
  },
  "key": "",
  "permissions": ["contextMenus", "downloads", "nativeMessaging", "notifications", "storage"],
  "host_permissions": ["https://mail.google.com/*"],
  "background": {
    "service_worker": "service-worker.js"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "content_scripts": [
    {
      "matches": ["https://mail.google.com/*"],
      "js": ["gmail.js"],
      "run_at": "document_idle"
    }
  ]
}
