{
  "manifest_version": 3,
  "name": "DocBunker",
  "version": "0.1.0",
  "description": "Open webmail attachments in the isolated DocBunker viewer.",
  "icons": {
    "128": "icon-128.png"
  },
  "key": "",
  "permissions": ["contextMenus", "downloads", "nativeMessaging", "notifications", "storage"],
  "host_permissions": [
    "https://mail.google.com/*",
    "https://outlook.live.com/*",
    "https://outlook.office.com/*",
    "https://outlook.office365.com/*",
    "https://mail.yahoo.com/*",
    "https://mail.proton.me/*",
    "https://mail.protonmail.com/*",
    "https://www.icloud.com/*",
    "https://mail.zoho.com/*",
    "https://gmx.com/*",
    "https://gmx.net/*",
    "https://www.web.de/*",
    "https://mail.com/*",
    "https://mail.aol.com/*"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "commands": {
    "open-focused-attachment": {
      "suggested_key": {
        "default": "Ctrl+Shift+O",
        "mac": "Command+Shift+O"
      },
      "description": "Open focused attachment in DocBunker"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://mail.google.com/*",
        "https://outlook.live.com/*",
        "https://outlook.office.com/*",
        "https://outlook.office365.com/*",
        "https://mail.yahoo.com/*",
        "https://mail.proton.me/*",
        "https://mail.protonmail.com/*",
        "https://www.icloud.com/*",
        "https://mail.zoho.com/*",
        "https://gmx.com/*",
        "https://gmx.net/*",
        "https://www.web.de/*",
        "https://mail.com/*",
        "https://mail.aol.com/*"
      ],
      "js": ["webmail.js"],
      "run_at": "document_idle"
    }
  ]
}
