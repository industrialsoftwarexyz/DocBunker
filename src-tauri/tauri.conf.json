{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DocBunker",
  "version": "0.1.0",
  "identifier": "dev.docbunker.viewer",
  "build": {
    "beforeDevCommand": "npm --prefix ../frontend run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm --prefix ../frontend run build",
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "title": "DocBunker",
        "width": 1100,
        "height": 760,
        "minWidth": 640,
        "minHeight": 480,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src ipc: http://ipc.localhost; font-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'",
      "devCsp": "default-src 'self' http://localhost:1420; script-src 'self' 'unsafe-eval' http://localhost:1420; style-src 'self' 'unsafe-inline' http://localhost:1420; img-src 'self' data: blob:; connect-src ipc: http://ipc.localhost http://localhost:1420 ws://localhost:1420; font-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'",
      "capabilities": ["default"]
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["docbunker"]
      },
      "mobile": {
        "schemes": ["docbunker"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "../sandbox/vm/": "vm/",
      "../browser-extension/": "browser-extension/"
    },
    "fileAssociations": [
      {
        "ext": ["pdf"],
        "name": "DocBunker PDF",
        "description": "Documento PDF",
        "mimeType": "application/pdf",
        "role": "Viewer"
      },
      {
        "ext": ["png"],
        "name": "DocBunker PNG",
        "description": "Imagen PNG",
        "mimeType": "image/png",
        "role": "Viewer"
      },
      {
        "ext": ["jpg", "jpeg"],
        "name": "DocBunker JPEG",
        "description": "Imagen JPEG",
        "mimeType": "image/jpeg",
        "role": "Viewer"
      },
      {
        "ext": ["webp"],
        "name": "DocBunker WebP",
        "description": "Imagen WebP",
        "mimeType": "image/webp",
        "role": "Viewer"
      },
      {
        "ext": ["docx", "pptx", "xlsx"],
        "name": "DocBunker Office",
        "description": "Documento de Office (vista previa de texto)",
        "mimeType": "application/octet-stream",
        "role": "Viewer"
      }
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
